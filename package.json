{
  "name": "elval-helper",
  "displayName": "ElVal Helper",
  "description": "Syntax highlighting and autocomplete for ElVal annotations in Go.",
  "version": "0.1.0",
  "publisher": "arkannsk",
   "contributes": {
    "configuration": {
      "title": "ElVal Helper",
      "properties": {
        "elval.helper.colors.directive": {
          "type": "string",
          "default": "#61AFEF", 
          "description": "Color for @evl: and @oa: directives."
        },
        "elval.helper.colors.paramSimple": {
          "type": "string",
          "default": "#98C379",
          "description": "Color for simple parameters like 'required'."
        },
        "elval.helper.colors.paramKv": {
          "type": "string",
          "default": "#E5C07B",
          "description": "Color for KV parameters like 'min:'."
        },
        "elval.helper.colors.value": {
          "type": "string",
          "default": "#56B6C2",
          "description": "Color for values like 'uuid' or '100'."
        },
        "elval.helper.colors.oaKey": {
          "type": "string",
          "default": "#E5C07B",
          "description": "Color for OpenAPI keys like '@oa:description'."
        },
         "elval.helper.colors.location": {
          "type": "string",
          "default": "#61AFEF",
          "description": "Color for locations like 'query', 'header'."
        },
        "elval.helper.colors.paramName": {
          "type": "string",
          "default": "#ABB2BF",
          "description": "Color for parameter names after @oa:in (e.g., 'page')."
        },
        
        "--- Стили ---": {},
        
        "elval.helper.styles.directive.fontWeight": {
          "type": "string",
          "enum": ["normal", "bold"],
          "default": "bold",
          "description": "Font weight for directives."
        },
        "elval.helper.styles.directive.fontStyle": {
          "type": "string",
          "enum": ["normal", "italic"],
          "default": "normal",
          "description": "Font style for directives."
        },
        "elval.helper.styles.value.fontWeight": {
          "type": "string",
          "enum": ["normal", "bold"],
          "default": "normal", 
          "description": "Font weight for values."
        },
        "elval.helper.styles.value.textDecoration": {
          "type": "string",
          "enum": ["none", "underline", "line-through", "wavy"],
          "default": "none", 
          "description": "Text decoration for values."
        }
      }
    },
    "commands": [
      {
        "command": "elval.helper.changeColors",
        "title": "ElVal: Change Highlighting Colors & Styles"
      }
    ]
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:go"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  }
}