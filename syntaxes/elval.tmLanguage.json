{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ElVal Annotations",
  "scopeName": "comment.elval.golang",
  "injectionSelector": "L:source.go -string -comment.block",
  "patterns": [
    { "include": "#elval-directives" },
    { "include": "#oa-directives" }
  ],
  "repository": {
    "elval-directives": {
      "patterns": [
        {
          "name": "keyword.control.elval.directive",
          "match": "@evl:(validate|decor|rewrite)\\b"
        },
        {
          "name": "entity.name.function.elval.param.simple",
          "match": "\\b(required|optional|not-zero|email|uuid|phone|ip|url|http_url|trim|lowercase|uppercase|inline|flatten|time-now|uuid-gen)\\b"
        },
        {
          "name": "entity.name.function.elval.param.kv",
          "match": "\\b(min|max|len|gt|lt|gte|lte|eq|neq|pattern|enum|contains|starts_with|ends_with|ctx-get|httpctx-get|env-get|default|prefix|suffix|ref|type):"
        },
        {
          "name": "string.quoted.double.elval.value",
          "match": "(?<=:)\\S+"
        }
      ]
    },
    "oa-directives": {
      "patterns": [
        {
          "name": "meta.annotation.oa.key",
          "match": "@oa:[a-zA-Z.]+\\b"
        },
        {
          "name": "string.quoted.double.oa.value",
          "match": "\"[^\"]*\""
        },
        {
          "name": "variable.other.elval.location",
          "match": "(?<=@oa:in\\s)(query|header|path|cookie)\\b"
        }
      ]
    }
  }
}
